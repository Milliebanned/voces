# AssemblyAI — powers both the real-time Voice Agent session and the
# post-session transcript analysis. Server-side only, never exposed to the browser.
ASSEMBLYAI_API_KEY=

# Supabase — Postgres + Auth. Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Bypasses row-level security — never expose to the browser.
SUPABASE_SECRET_KEY=
