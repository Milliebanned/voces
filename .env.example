# AssemblyAI — powers both the real-time Voice Agent session and the
# post-session transcript analysis. Server-side only, never exposed to the browser.
ASSEMBLYAI_API_KEY=

# Optional. LLM Gateway model for the post-session review. Defaults to
# qwen3.5-4b-32k-fast, which every plan includes; claude-sonnet-4-6 gives
# noticeably better grammar corrections if your plan has it.
ANALYSIS_MODEL=

# Supabase — Postgres + Auth. Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Bypasses row-level security — never expose to the browser.
SUPABASE_SECRET_KEY=
